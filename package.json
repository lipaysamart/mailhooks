{
  "name": "mailhooks",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "sync": "bun run src/sync.ts",
    "consumer": "bun run src/consumer.ts",
    "build": "bun build src/index.ts src/sync.ts src/consumer.ts --outdir dist --target bun",
    "test": "bun test"
  },
  "dependencies": {
    "imap": "^0.8.19",
    "js-yaml": "^4.1.0",
    "mailparser": "^3.6.5",
    "nodemailer": "^8.0.5",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "socks-proxy-agent": "^10.0.0"
  },
  "devDependencies": {
    "@types/imap": "^0.8.40",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.10.5",
    "bun-types": "^1.0.18",
    "typescript": "^5.3.3"
  }
}